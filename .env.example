# FAAR cluster handoff configuration.
# Copy to .env, fill values, and never commit .env.
# Names and placeholders only; add no secrets to this file.

# Repository root (usually the checkout directory).
FAAR_PROJECT_ROOT=

# Scratch filesystem for job outputs and the HF model cache.
FAAR_SCRATCH=

# Output root for prepared assets (defaults to FAAR_SCRATCH).
FAAR_OUT_ROOT=

# Hugging Face cache location (defaults to FAAR_SCRATCH/huggingface).
HF_HOME=

# OHR PDF sources; leave both empty to use data/ohr_bench_raw/pdfs.zip.
FAAR_PDF_ROOT=
FAAR_PDF_ZIP=

# OHR per-document page inventory (defaults to OHR-Bench/data/retrieval_base/gt).
FAAR_DOCUMENT_INVENTORY=

# Positive GiB VRAM budget for the process, chosen from the preflight report.
FAAR_GPU_BUDGET_GB=

# Co-tenant free-VRAM reserve in GiB (defaults to 20% of visible VRAM).
FAAR_MIN_GPU_FREE_GB=

# In-process RSS guard in GiB (launcher derives from the scheduler allocation).
FAAR_MAX_RSS_GB=

# Alternative single GPU limit; do not set together with FAAR_GPU_BUDGET_GB.
FAAR_MAX_GPU_MEMORY_FRACTION=

# CPU library thread caps (launcher derives half the allocated CPUs).
OMP_NUM_THREADS=
MKL_NUM_THREADS=

# VLM backend for paid baseline stages: openai | claude-sonnet-4-5.
VLM_BACKEND=

# Credentials are read from the environment or this .env; values are never
# printed. Required only for paid VLM stages (B1/B2/B4).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Token for gated Hugging Face models if required by the cluster.
HF_TOKEN=
